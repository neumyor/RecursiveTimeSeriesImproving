        "source": "import numpy as np\n\n\ndef create_probe():\n    return HorizonRatioProbe()\n\n\nclass HorizonRatioProbe:\n    def __init__(self):\n        self.probe_id = \"horizon-ratio\"\n\n    def run(self, artifacts):\n        h = int(artifacts[\"meta\"][\"H\"])\n        e = np.asarray(artifacts[\"residuals\"][\"e\"], dtype=np.float64)\n        e = e[np.isfinite(e).all(axis=1)]\n        gap = h - 1\n        long_step = e[gap:, 0] - e[:-gap, 0]\n        short_step = e[1:, 0] - e[:-1, 0]\n        num = float(np.mean(long_step * long_step))\n        den = float(np.mean(short_step * short_step))\n        return {\"horizonRatio\": num / den}\n",
