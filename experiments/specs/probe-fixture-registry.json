        "source": "import numpy as np\n\n\ndef create_probe():\n    return LevelBiasProbe()\n\n\nclass LevelBiasProbe:\n    def __init__(self):\n        self.probe_id = \"level-bias-mu2\"\n\n    def run(self, artifacts):\n        e = np.asarray(artifacts[\"residuals\"][\"e\"], dtype=np.float64)\n        e = e[np.isfinite(e).all(axis=1)]\n        blocks = 8\n        size = e.shape[0] // blocks\n        means = e[: size * blocks].reshape(blocks, size, e.shape[1]).mean(axis=1)\n        return {\"mu2\": float(np.mean(means * means))}\n",
